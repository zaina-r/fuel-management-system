# Fuel Management System - Configuration Template
# Copy this file to application.properties and update with your actual values

spring.application.name=fuel_management_system

# Show SQL queries in console (useful for development, disable in production)
spring.jpa.show-sql=true

# Server Port
server.port=8080

# Database Configuration
spring.datasource.url=jdbc:mysql://localhost:3306/fuelmanagement?createDatabaseIfNotExist=true
spring.datasource.driverClassName=com.mysql.cj.jdbc.Driver
spring.jpa.hibernate.ddl-auto=update
spring.datasource.username=root
spring.datasource.password=YOUR_MYSQL_PASSWORD_HERE

# Mail Configuration (for OTP and Password Reset)
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=YOUR_EMAIL@gmail.com
spring.mail.password=YOUR_APP_PASSWORD_HERE
spring.mail.protocol=smtp
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

# Twilio Configuration (Optional - for SMS notifications)
# Uncomment and configure if using Twilio
# twilio.account.sid=YOUR_TWILIO_ACCOUNT_SID
# twilio.auth.token=YOUR_TWILIO_AUTH_TOKEN
# twilio.phone.number=YOUR_TWILIO_PHONE_NUMBER

# JWT Configuration (Optional - if using JWT)
# jwt.secret=YOUR_SECRET_KEY_HERE_MINIMUM_256_BITS
# jwt.expiration=86400000

# Logging Configuration
logging.level.org.springframework=INFO
logging.level.org.example.fuel_management_system=DEBUG
